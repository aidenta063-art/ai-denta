# Copy this file to .env and fill in real values. .env itself is gitignored.

DATABASE_URL="postgresql://user:password@localhost:5432/ai_denta?schema=public"

# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
AUTH_SECRET=""

APP_URL="http://localhost:3000"

# Optional, local dev only — creates an ADMIN user on `prisma db seed` when both are set.
DEV_ADMIN_EMAIL=""
DEV_ADMIN_PASSWORD=""

# Optional — Cloudflare R2 for media storage. When unset, uploads fall back
# to local disk (public/uploads), which only works for a single instance.
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET=""
R2_PUBLIC_BASE_URL=""

# Optional — Google OAuth ("Sign in with Google"). When unset, the Google
# button is hidden and only email/password auth is available.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Bearer token the Vercel cron job must send to trigger slot generation
# (see src/app/api/cron/generate-slots). Generate the same way as AUTH_SECRET.
CRON_SECRET=""

# Arbitrary secret string you also paste into Meta's WhatsApp app dashboard
# (App > WhatsApp > Configuration > Webhooks > Verify token) — proves the
# webhook handshake request actually came from that app. Not a real
# password, just needs to match on both sides.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=""

# WhatsApp Cloud API credentials for sending messages (booking confirmation
# + appointment reminders). From Meta Business Settings > System Users
# (permanent access token) and the WhatsApp app's Phone Number/WABA IDs.
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Names of the approved Meta message templates (WhatsApp Manager > Message
# Templates) used for the three client touchpoints.
WHATSAPP_TEMPLATE_BOOKING_CONFIRMED=""
WHATSAPP_TEMPLATE_REMINDER_24H=""
WHATSAPP_TEMPLATE_REMINDER_1H=""
